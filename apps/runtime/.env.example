# Only needed for the real production entrypoint (start.js). dev-start.js
# (used for local testing without credentials, mock BSP) never reads these.

OPENAI_API_KEY=
THREE_SIXTY_DIALOG_API_KEY=

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Required by both start.js and dev-start.js
SANDBOX_PHONE_NUMBER_ID=
SANDBOX_WHATSAPP_NUMBER=

# Optional, defaults to 3002
PORT=
