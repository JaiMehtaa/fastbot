# Auth (browser + server session cookies) — the anon key, safe to expose client-side
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side data access (createDbClient) — the service-role key, NEVER expose client-side
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Where apps/runtime's HTTP API is running (used by the connect-number server action)
RUNTIME_API_URL=http://localhost:3002
